# Copy this file to `.env` and fill in your own values.
# The agent loads `.env` automatically at startup (real environment variables win).

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# "openai" talks to any OpenAI-compatible /chat/completions endpoint
# (OpenAI, OpenRouter, Groq, Together, DeepSeek, a local Ollama/llama.cpp...).
# "mock" replays a scripted list of responses and is only used for offline demos
# and the project's own test suite.
LLM_PROVIDER=openai

# Your API key. Keep this out of version control.
LLM_API_KEY=sk-your-key-here

# Base URL of the API. Change it to point at a different provider.
LLM_BASE_URL=https://api.openai.com/v1

# Model name understood by that provider.
LLM_MODEL=gpt-4o-mini

# Sampling temperature. 0 keeps fixes deterministic.
LLM_TEMPERATURE=0
# Seconds to wait for a single LLM response.
LLM_TIMEOUT=60

# ---------------------------------------------------------------------------
# Agent behaviour
# ---------------------------------------------------------------------------
# Directory the agent is allowed to read and write. Everything outside it is blocked.
WORKSPACE=./sample_project

# The test command the agent runs. The LLM can never choose or change this.
TEST_COMMAND=python -m pytest -q

# How many fix -> test cycles to allow before giving up.
MAX_ATTEMPTS=3

# Safety valve: how many tool calls the model may make per attempt.
MAX_TOOL_CALLS=10

# Seconds a single test run may take.
TEST_TIMEOUT=300

# Set to 1 to skip the interactive approval prompt (useful for demos/CI).
AGENT_AUTO_APPROVE=0

# Only used when LLM_PROVIDER=mock: a JSON file holding a list of responses.
MOCK_RESPONSES_FILE=./examples/mock_responses.json
